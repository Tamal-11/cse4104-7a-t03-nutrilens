# Server-side only. Do not put real credentials in this file.
# Frontend configuration belongs in frontend/.env.

# Local AI keys are managed from the admin dashboard at /admin.
# Production may use GEMINI_API_KEY as a server-side fallback secret.
GEMINI_MODEL=gemini-flash-lite-latest

# Neon and Worker settings
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_URL=https://your-neon-auth-endpoint
MAX_IMAGE_UPLOAD_BYTES=8388608
