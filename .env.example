# Frontend
VITE_API_BASE_URL=http://localhost:8787

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Neon Auth endpoint provided by the Neon console
NEON_AUTH_URL=https://your-neon-auth-endpoint

# Cloudflare R2
R2_PUBLIC_BASE_URL=https://your-public-r2-domain

# Optional external services
NUTRITION_API_KEY=your_nutrition_api_key
AI_MODEL_ENDPOINT=http://127.0.0.1:8788/predict
AI_MODEL_API_KEY=
ADMIN_EMAILS=admin@example.com
MAX_IMAGE_UPLOAD_BYTES=8388608

# Local Node.js ONNX AI service
AI_NODE_PORT=8788
AI_NODE_HOST=127.0.0.1
AI_NODE_MODEL_PATH=./models/food101-mobilenetv2.onnx
AI_NODE_LABELS_PATH=./data/food101-labels.json
AI_NODE_NUTRITION_PATH=./data/nutrition-db.json
AI_NODE_MODEL_ID=AlexKoff88/mobilenet_v2_food101
AI_NODE_IMAGE_SIZE=224
AI_NODE_INPUT_LAYOUT=NCHW
AI_NODE_TOP_K=5
