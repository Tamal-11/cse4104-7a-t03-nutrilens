# NutriLens local demo defaults
# These placeholder values are safe for submission. Do not put real credentials here.

# Frontend
VITE_API_BASE_URL=http://localhost:8787
# Comma-separated browser origins allowed to send credentialed API requests.
# Set this to the exact deployed frontend origin before production deployment.
ALLOWED_ORIGINS=http://localhost:3000

# Local demo API
LOCAL_DEMO_MODE=true
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8787
LOCAL_DEMO_EMAIL=demo@nutrilens.local
LOCAL_DEMO_NAME=NutriLens Demo User
MAX_IMAGE_UPLOAD_BYTES=8388608

# Local Node.js ONNX AI service
AI_MODEL_ENDPOINT=http://127.0.0.1:8788/predict
AI_MODEL_API_KEY=
AI_REQUEST_TIMEOUT_MS=30000
AI_NODE_PORT=8788
AI_NODE_HOST=127.0.0.1
AI_NODE_MODEL_PATH=./models/st_efficientnetlcv1_224_tfs_qdq_int8.onnx
AI_NODE_LABELS_PATH=./data/food101-labels.json
AI_NODE_NUTRITION_PATH=./data/nutrition-db.json
AI_NODE_MODEL_KIND=stmicro_effnet_int8_food101
AI_NODE_MODEL_URL=https://github.com/STMicroelectronics/stm32ai-modelzoo/raw/refs/heads/main/image_classification/efficientnet/ST_pretrainedmodel_public_dataset/food101/st_efficientnetlcv1_224_tfs/st_efficientnetlcv1_224_tfs_qdq_int8.onnx
AI_NODE_RESIZE_SIZE=256
AI_NODE_TOP_K=5

# Production/cloud values are only needed when using the Cloudflare Worker backend.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_URL=https://your-neon-auth-endpoint
R2_PUBLIC_BASE_URL=
NUTRITION_API_KEY=your_nutrition_api_key
ADMIN_EMAILS=admin@example.com
