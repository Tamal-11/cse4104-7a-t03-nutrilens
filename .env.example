# Server-side only. Do not put real credentials in this file.
# Frontend configuration belongs in frontend/.env.

# Gemini AI (never expose this value with a VITE_ prefix)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Neon and Worker settings
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_URL=https://your-neon-auth-endpoint
ADMIN_EMAILS=admin@example.com
MAX_IMAGE_UPLOAD_BYTES=8388608
