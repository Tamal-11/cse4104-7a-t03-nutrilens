{
  "name": "cse4104-7a-t03-nutrilens",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev:frontend": "corepack pnpm --dir frontend run dev",
    "dev:backend": "corepack pnpm --dir backend run dev",
    "deploy": "corepack pnpm --dir backend run deploy",
    "db:migrate": "corepack pnpm --dir backend run db:migrate",
    "build:frontend": "corepack pnpm --dir frontend run build",
    "typecheck:backend": "corepack pnpm --dir backend run typecheck",
    "dev:ai": "corepack pnpm --dir ai-node run dev",
    "build:ai": "corepack pnpm --dir ai-node run build",
    "typecheck:ai": "corepack pnpm --dir ai-node run typecheck",
    "model:download": "corepack pnpm --dir ai-node run model:download",
    "model:check": "corepack pnpm --dir ai-node run model:check",
    "dev:local": "corepack pnpm --parallel --filter nutrilens-ai-node --filter nutrilens-backend --filter nutrilens-frontend run dev"
  }
}
